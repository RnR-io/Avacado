#!/usr/bin/env python3
"""
Avocado Terminal App Launcher
"""
import sys
import os

# Resolve real path to handle Homebrew symlinks properly
REAL_SCRIPT = os.path.realpath(__file__)
APP_ROOT = os.path.dirname(os.path.dirname(REAL_SCRIPT))
if APP_ROOT not in sys.path:
    sys.path.insert(0, APP_ROOT)

from avocado.main import main

if __name__ == "__main__":
    main()
